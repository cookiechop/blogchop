---
import '../styles/global.css';
interface Props {
	title: string;
	description: string;
	image?: string;
}
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = '/blog-placeholder-1.jpg' } = Astro.props;
---
<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads (fixed: type should be font/woff, not font/cause) -->
<link rel="preload" href="/fonts/cause.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/cause-bold.woff" as="font" type="font/woff" crossorigin />

<!-- CSP: added giscus.app to allowed scripts, and giscus.app/static.cloudflareinsights.com to frame-src -->
<meta http-equiv="Content-Security-Policy" content="
  default-src 'self';
  script-src 'self' 'unsafe-inline' https://giscus.app https://static.cloudflareinsights.com;
  style-src 'self' 'unsafe-inline';
  font-src 'self' data:;
  img-src 'self' data:;
  frame-src https://giscus.app;
  connect-src 'self' https://giscus.app;
" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- SEO -->
<title>{title}</title>
<meta name="description" content={description} />
