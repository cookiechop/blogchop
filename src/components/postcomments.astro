---
const pageUrl = `https://cookiechop.com${Astro.url.pathname}`;
const pageId = Astro.url.pathname;
const pageTitle = Astro.props.title ?? 'Untitled';
---
<div id="cusdis_thread"
  data-host="https://cusdis.com"
  data-app-id="1f061272-396f-4fe5-995b-3036daf88061"
  data-page-id={pageId}
  data-page-url={pageUrl}
  data-page-title={pageTitle}
  data-theme="auto"
></div>
<script is:inline async defer src="https://cusdis.com/js/cusdis.es.js"></script>
<script is:inline>
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.addedNodes.length === 0) return;
      const iframe = mutation.addedNodes[0];
      if (iframe.tagName !== 'IFRAME') return;
      const styles = `
        body { font-family: sans-serif; background: #d4f6ff; }
        button { background: #FFF3A6; border: 2px solid #E0D58B; border-radius: 999px; color: #5E3800; }
        button:hover { background: #E0D58B; }
        input, textarea { border: 2px solid #c9cd7b; border-radius: 8px; background: #F7F7F7; }
      `;
      iframe.srcdoc = iframe.srcdoc.replace('</style>', styles + '</style>');
    });
  });
  observer.observe(document.getElementById('cusdis_thread'), { childList: true, subtree: true });
</script>
