---
import Layout from '../../layouts/Layout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<style>
		.blog-intro {
			margin: 0 0 1rem 0;
		}

		.post-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
			gap: 1.2rem;
			list-style: none;
			margin: 0;
			padding: 0;
		}

		.post-grid li a {
			display: block;
			text-decoration: none;
		}

		.post-grid img {
			display: block;
			width: 100%;
			aspect-ratio: 16 / 10;
			object-fit: cover;
			border-radius: 8px;
			margin-bottom: 0.4rem;
			transition: transform 0.2s ease;
		}

		.post-grid a:hover img {
			transform: scale(1.04);
		}

		.post-title {
			margin: 0;
			font-size: 0.95em;
			line-height: 1.25;
			color: var(--accent);
		}

		.post-date {
			margin: 0.15rem 0 0 0;
			font-size: 0.78em;
			color: var(--accent);
		}

		.post-grid a:hover .post-title,
		.post-grid a:hover .post-date {
			color: var(--accent);
		}

		@media (max-width: 480px) {
			.post-grid {
				grid-template-columns: repeat(2, 1fr);
				gap: 0.8rem;
			}
		}
	</style>

	<h2 class="blog-intro">Click a picture to view the post!</h2>
	<ul class="post-grid">
		{
			posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						<img width={360} height={225} src={post.data.heroImage} alt="" />
						<h4 class="post-title">{post.data.title}</h4>
						<p class="post-date">
							<FormattedDate date={post.data.pubDate} />
						</p>
					</a>
				</li>
			))
		}
	</ul>
</Layout>
