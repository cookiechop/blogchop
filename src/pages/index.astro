---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css'; 
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		
		<!-- THE DOG - Preserved exactly as requested -->
		<div style="position: fixed; left: 10px; bottom: 10px; z-index: 200;">
			<img src="/images/annoyingdog.gif" style="max-height: 120px; width: auto;" alt="Annoying dog"/>
		</div>
	</head>
	<body>
		
		<!-- NEW NAVIGATION BAR (Replaces <Header /> for now to apply styles) -->
		<!-- If you want to keep using <Header />, ensure that component has class="nav-bar" -->
		<header class="nav-bar">
			<a href="/" class="nav-logo">My Blog</a>
			<nav class="nav-links">
				<a href="/">Home</a>
				<a href="/blog">Blog</a>
				<a href="/about">About</a>
			</nav>
		</header>

		<!-- NEW GRID LAYOUT WRAPPER -->
		<div class="layout-container">
			
			<!-- SIDEBAR (Left Column) -->
			<aside class="sidebar">
				<h3>Navigation</h3>
				<ul>
					<li><a href="/">Home</a></li>
					<li><a href="/blog">All Posts</a></li>
					<li><a href="/about">About Me</a></li>
				</ul>

				<h3 style="margin-top: 2rem;">Status</h3>
				<p style="font-size: 0.9rem; color: rgb(var(--gray-dark));">
					This site is under construction. 
					Broken links and bugs are expected!
				</p>
			</aside>

			<!-- MAIN CONTENT AREA (Right Column) -->
			<main class="content-area">

				<img 
					src="/images/your-header-image.jpg" 
					alt="Header Banner" 
					class="featured-image" 
					style="width: 100%; height: auto; margin-bottom: 2rem;"
				/>
				
				<!-- TEXT CONTENT -->
				<h1>Welcome to my blog!</h1>
				<p>
					I'm intending this to be a creative project that I can build onto overtime as I try to distance myself from popular social media sites. 
				</p>
				<p>
					I am new to coding, so this website is very much under construction, and it will probably be broken a lot of the time!! 
				</p>

				<!-- Optional: Add a decorative image block here if you want -->
				<!-- 
				<div class="text-block">
					<p>Future updates will include more content here.</p>
				</div> 
				-->

			</main>
		</div>

		<!-- FOOTER -->
		<Footer />

	</body>
</html>
