---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<div style="position: fixed; left: 10px; bottom: 10px; z-index: 200;">
  <img src="/images/annoyingdog.gif" style="max-height: 120px; width: auto;" alt="Annoying dog"/>
</div>
	<body>
		<Header />
		<main>
			<h1>Welcome to my blog!!</h1>
			<p>
				This is where I will be posting crossword puzzles! 
			</p>
			<p>
				Stay tuned...
			</p>
		</main>
		<Footer />
	</body>
</html>
