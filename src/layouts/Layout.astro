---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title || SITE_TITLE} description={description || SITE_DESCRIPTION} />
		
		<!-- DOG EASTER EGG -->
		<div style="position: fixed; left: 10px; bottom: 10px; z-index: 200;">
			<img src="/images/annoyingdog.gif" style="max-height: 120px; width: auto;" alt="Annoying dog"/>
		</div>
	</head>
	<body>
		
		<!-- FLOATING CENTERED SIDEBAR -->
		<nav class="fixed-sidebar">
			<div class="sidebar-header">
				<a href="/" class="nav-logo">My Blog</a>
			</div>
			
			<ul class="sidebar-links">
				<li><a href="/">Home</a></li>
				<li><a href="/blog">Blog</a></li>
				<li><a href="/about">About</a></li>
				<li><a href="/Puzzles">Puzzles</a></li>
			</ul>

			<div class="sidebar-status">
				<h3>Status</h3>
				<p>This site is under construction.<br>Works best on desktop!</p>
			</div>
		</nav>

		<!-- MAIN CONTENT AREA (Centered) -->
		<div class="main-content-wrapper">
			
			<!-- BANNER -->
			<div class="layout-container">
				<div class="banner-wrapper">
					<slot name="banner" />
				</div>

				<!-- PAGE CONTENT -->
				<main class="content-area">
					<slot />
				</main>
			</div>

			<!-- FOOTER -->
			<Footer />
		</div>

	</body>
</html>
