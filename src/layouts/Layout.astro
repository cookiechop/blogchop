---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title || SITE_TITLE} description={description || SITE_DESCRIPTION} />
		
<!-- DOG  -->
		<div style="position: fixed; left: 10px; bottom: 10px; z-index: 200;">
			<img src="/images/annoyingdog.gif" style="max-height: 120px; width: auto;" alt="Annoying dog"/>
			</div>
				</head>

<body style="margin: 0; padding: 0;">

<!-- MAIN LAYOUT WRAPPER -->
	<div class="layout-container">

	<!-- 1. BANNER -->
    <div class="banner-wrapper">
        <img 
            src="/images/banner.jpeg" 
            alt="Header Banner" 
            class="featured-image" 
            style="margin: 0 !important; padding: 0 !important; display: block;"
        />
    </div>
			
		<!-- SIDEBAR -->
			<aside class="sidebar">
				<h4>Menu</h4>
				<ul>
					<li><a href="/">Home</a></li>
					<li><a href="/blog">Posts</a></li>
					<li><a href="/puzzles">Puzzles</a></li>
					<li><a href="/about">About Me</a></li>
				</ul>

				<h4 style="margin-top: 0.5rem;">Status</h4>
				<p style="font-size: 0.9rem; color: rgb(var(--gray-dark));">
					This site is under construction. 
					Works best on desktop!
				</p>
			</aside>

<!-- MAIN CONTENT AREA -->
	<main class="content-area">
				
				<!-- Text Content -->
				<h1>Welcome to my blog!</h1>
				<p>
					I'm intending this to be a creative project that I can build onto overtime as I try to distance myself from popular social media sites. 
				</p>
				<p>
					I am new to coding, so this website is very much under construction, and it will probably be broken a lot of the time!! 
				</p>

			</main>
		</div>

		<!-- FOOTER -->
		<Footer />

	</body>
</html>
