---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import Postcomments from '../components/postcomments.astro';
import '../styles/global.css';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---
<style>
	.post-date {
		font-size: 0.85em;
		margin-bottom: 0.75rem;
	}
	.post-date .last-updated-on {
		font-style: italic;
	}
	.post-hero-image {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 1rem;
	}
</style>
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title || SITE_TITLE} description={description || SITE_DESCRIPTION} />
<!-- DOG  -->
		<div style="position: fixed; left: 10px; bottom: 10px; z-index: 200;">
			<img src="/images/annoyingdog.gif" style="max-height: 120px; width: auto;" alt="Annoying dog"/>
			</div>
				</head>
<body style="margin: 0; padding: 0;">
	<div class="layout-container">
		<!-- 1. BANNER -->
		<div class="banner-wrapper">
			<img 
				src="/images/banner.jpg" 
				alt="Header Banner" 
				class="banner"
				style="width: 98%; height: auto; margin: 0 !important; padding: 0 !important; display: block;"
			/>
		</div>
		<!-- 2. SIDEBAR -->
		<aside class="sidebar">
			<h3 style="text-align: center;">Menu</h3>
			<nav class="sidebar-nav">
				<a href="/" class="sidebar-btn"><img src="/images/blinkies/home.gif">  Home</a>
				<a href="/blog" class="sidebar-btn"><img src="/images/blinkies/eeffoc.gif">  Blog</a>  
				<a href="/puzzles" class="sidebar-btn"><img src="/images/blinkies/doggy.gif">  Puzzles</a>
				<a href="/newsletter" class="sidebar-btn"><img src="/images/blinkies/envelope.gif">  Newsletter</a>
				<a href="/survey" class="sidebar-btn"><img src="/images/blinkies/question.gif">  Survey</a>
			</nav>
			<img src="/images/borders/bunnywire.gif"/>
			<h3 style="margin-top: 1.5rem;">Note</h3>
			<p style="font-size: 0.9rem; color: black;">
				Works best on desktop!<br>
				Comments left may not immediately show as I must to approve them individually.
			</p>
			<h3>Updates</h3>
			<p style="font-size: 0.9rem; color: black;">
				8/31/2026: Site makeover!!
			</p>
			<h3>Contact</h3>
			<p style="font-size: 0.7rem; color: black;">
				cookie@cookiechop.com
			</p>
			<img src="/images/borders/milkncookies.png"/>
		</aside>
		<!-- 3. MAIN CONTENT AREA -->
		<main class="content-area">
			<div class="post-date">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span class="last-updated-on">
							 (Last updated on <FormattedDate date={updatedDate} />)
						</span>
					)
				}
			</div>
			{heroImage && (
				<img class="post-hero-image" src={heroImage} alt="" width={1020} height={510} />
			)}
			<slot />
		</main>
		<!-- 4. COMMENTS (below content, same column) -->
	<div class="page-comments">
	<h3>Comments</h3><p>Comment not showing? That's normal! I have to approve it before it can show.</p>
    <Postcomments title={title} />

    <script>
		// Cusdis renders via iframe srcdoc, which (unlike a normal cross-origin
		// iframe) shares your page's origin — so we can reach into its
		// contentDocument and inject our own styles once it's loaded.

		function styleCusdisIframe() {
			const iframe = document.querySelector('#cusdis_thread iframe');
			if (!iframe) return;

			const inject = () => {
				let doc;
				try {
					doc = iframe.contentDocument;
				} catch (e) {
					return; // not same-origin yet / not ready
				}
				if (!doc || !doc.body) return;
				if (doc.getElementById('cusdis-custom-style')) return; // already injected

				const style = doc.createElement('style');
				style.id = 'cusdis-custom-style';
				style.textContent = `
					/* === Base theme to match the site === */
					body {
						font-family: "Geist Pixel", sans-serif !important;
						color: #291A1A !important;
						background: transparent !important;
					}

					textarea, input {
						font-family: inherit !important;
						border-radius: 6px !important;
						border: 1px solid #b8e4f5 !important;
					}

					button {
						background-color: #FFC98A !important;
						border: 2px solid #FF9F45 !important;
						color: #5E3800 !important;
						border-radius: 6px !important;
						font-family: inherit !important;
					}

					button:hover {
						background-color: #FF9F45 !important;
					}

					/* === Comment spacing & dividers === */
					.my-4 {
						margin-top: 0.75rem !important;
						margin-bottom: 0.75rem !important;
					}

					/* Top-level comments (not inside a reply wrapper) get
					   a divider underneath to separate one commenter's
					   thread from the next. */
					#root > div > div.mt-4.px-1 > .my-4 {
						padding-bottom: 0.75rem !important;
						border-bottom: 1px dashed #d8d8d8 !important;
					}

					#root > div > div.mt-4.px-1 > .my-4:last-child {
						border-bottom: none !important;
					}

					/* === Commenter name & date === */
					.flex.items-center {
						font-weight: 700 !important;
						color: #5E3800 !important;
						font-size: 0.95em !important;
					}

					.text-gray-500.text-sm {
						color: rgb(96, 115, 159) !important;
						font-size: 0.75em !important;
						font-style: italic !important;
						margin-bottom: 0.35rem !important;
					}

					/* === Form field spacing === */
					form label, form > div {
						margin-bottom: 0.5rem !important;
					}

					input[type="text"], input[type="email"], textarea {
						margin-top: 0.2rem !important;
						margin-bottom: 0.6rem !important;
						padding: 0.35rem 0.5rem !important;
					}

					/* === Reply nesting ===
					   Cusdis already wraps nested replies in a div with
					   "pl-4 border-l-2 border-color-gray-200" (its own
					   built-in indent marker), so we target that combo
					   directly instead of guessing at div depth. This
					   only matches real reply-thread wrappers, not the
					   name/date/body divs inside a single comment. */
					.pl-4.border-l-2 {
						border-left-color: #a8dff0 !important;
						border-left-width: 3px !important;
						padding-left: 0.75rem !important;
						margin-top: 0.5rem !important;
					}

					.pl-4.border-l-2::before {
						content: "↳ reply";
						display: block;
						font-size: 0.7em;
						color: #5E3800;
						opacity: 0.6;
						margin-bottom: 0.15rem;
					}
				`;
				doc.head.appendChild(style);
			};

			// Try immediately, then retry briefly since Cusdis loads
			// its own content asynchronously after the iframe itself loads.
			iframe.addEventListener('load', () => {
				inject();
				setTimeout(inject, 300);
				setTimeout(inject, 1000);
			});

			// Also watch for content changes in case comments load in later
			// (e.g. after approval) or the iframe gets replaced.
			try {
				const obs = new MutationObserver(() => inject());
				if (iframe.contentDocument && iframe.contentDocument.body) {
					obs.observe(iframe.contentDocument.body, { childList: true, subtree: true });
				}
			} catch (e) {
				// ignore if not accessible yet
			}
		}

		// The iframe may not exist immediately on page load, so watch the
		// comments container for it to appear.
		const cusdisContainer = document.querySelector('#cusdis_thread');
		if (cusdisContainer) {
			styleCusdisIframe();
			const containerObserver = new MutationObserver(() => styleCusdisIframe());
			containerObserver.observe(cusdisContainer, { childList: true, subtree: true });
		}
	</script>
</div>
	</div> <!-- end .layout-container -->
	<Footer />
</body>
</html>
